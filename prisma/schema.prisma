generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Project {
  id       Int    @id @default(autoincrement())
  name     String
  location String

  schedules Schedule[]
}

model Worker {
  id     Int    @id @default(autoincrement())
  name   String
  team   String
  role   String

  schedules Schedule[]
}

model Schedule {
  id        Int      @id @default(autoincrement())
  workerId  Int
  projectId Int
  date      DateTime
  startTime String
  endTime   String

  worker  Worker  @relation(fields: [workerId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}