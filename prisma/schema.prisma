generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// ================= USER (LOGIN) =================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  client    Client?   // relation
}

// ================= CLIENT PROFILE =================
model Client {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])

  location  String
  projectName String @default("No Project")    
}

// ================= PROJECT =================
model Project {
  id        Int      @id @default(autoincrement())
  name      String
  location  String

  schedules Schedule[]
}

// ================= WORKER =================
model Worker {
  id     Int    @id @default(autoincrement())
  name   String
  team   String

  schedules Schedule[]
}

// ================= SCHEDULE =================
model Schedule {
  id        Int      @id @default(autoincrement())
  workerId  Int
  projectId Int
  date      DateTime
  startTime String
  endTime   String

  worker  Worker  @relation(fields: [workerId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

// ================= CONTACT =================
model ContactForm {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  message   String
  createdAt DateTime @default(now())
}